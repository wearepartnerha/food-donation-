# Copy this file to .env and fill in the values. .env is git-ignored — never commit real secrets.

# Public URL of the Food Connect API (the separately deployed food-connect-be service).
# VITE_-prefixed, so it is baked into the browser bundle — it must not be a secret.
# Defaults to http://localhost:4000 (the API's local dev server) when unset.
#
# The API's own .env must list this app's origin in FRONTEND_URL (e.g. http://localhost:8080)
# so CORS allows it and Google sign-in redirects back here.
VITE_API_URL="http://localhost:4000"
